# --- App ---
APP_NAME=FixIt API
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-byte-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# --- Database ---
POSTGRES_USER=fixit
POSTGRES_PASSWORD=fixit
POSTGRES_DB=fixit
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fixit:fixit@db:5432/fixit

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
